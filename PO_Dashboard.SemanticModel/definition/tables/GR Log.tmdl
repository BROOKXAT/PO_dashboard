	partition 'GR Log' = m
		mode: import
		source =
				// ============================================================================
				// Power Query (M) – table "GR Log"
				// Source: sheet "GR Log" of the Excel file in the FilePath parameter.
				// Not related to "PO Data": the two sheets are independent.
				// ============================================================================
				let
				    SheetName = "GR Log",
				
				    // ---- 1. Load -----------------------------------------------------------
				    Source   = Excel.Workbook(File.Contents(FilePath), true, true),   // true = first row is the header
				    Sheets   = Table.SelectRows(Source, each [Kind] = "Sheet"),
				    Matching = Table.SelectRows(Sheets, each Text.Lower(Text.Trim([Name])) = Text.Lower(SheetName)),
				    Raw      =
				        if not Table.IsEmpty(Matching) then Matching{0}[Data]
				        else error Error.Record(
				            "Sheet not found",
				            "No sheet named '" & SheetName & "' in " & FilePath
				                & ". Sheets found: " & Text.Combine(Sheets[Name], ", ")),
				
				    // Header cleanup: trim, drop line breaks, collapse double spaces
				    CleanHeaders = Table.TransformColumnNames(
				        Raw,
				        each Text.Combine(List.Select(Text.SplitAny(Text.Clean(Text.From(_)), " #(00A0)"), (w) => w <> ""), " ")),
				
				    // ---- 2. Expected columns { name, kind } (matched case-insensitively) ----
				    Columns = {
				        {"Delivery Date", "Date"}, {"GR Date", "Date"}, {"Delivery Status", "Text"},
				        {"PO Number", "Text"}, {"PO Item", "Whole"}, {"Supplier", "Text"}, {"Material", "Text"},
				        {"Material Description", "Text"}, {"Type (MP/AC)", "Text"}, {"Ordered Qty", "Decimal"},
				        {"Received Qty", "Decimal"}, {"UoM", "Text"}, {"Remaining Qty", "Decimal"}, {"GR Status", "Text"},
				        {"SAP Batch", "Text"}, {"Supplier Batch", "Text"}, {"Expiry Date", "Date"},
				        {"Days to Expiry", "Whole"}, {"COA Received", "Text"}, {"QC Status", "Text"}, {"Comments", "Text"}
				    },
				    Names        = List.Transform(Columns, each _{0}),
				    ExcelHeaders = Table.ColumnNames(CleanHeaders),
				    FindHeader   = (name as text) as nullable text =>
				        List.First(List.Select(ExcelHeaders, (h) => Text.Lower(h) = Text.Lower(name)), null),
				    Matches  = List.Transform(Names, (c) => {FindHeader(c), c}),
				    Missing  = List.Transform(List.Select(Matches, each _{0} = null), each _{1}),
				    Renames  = List.Select(Matches, each _{0} <> null and _{0} <> _{1}),
				    Renamed  =
				        if List.IsEmpty(Missing) then Table.RenameColumns(CleanHeaders, Renames)
				        else error Error.Record(
				            "Missing columns",
				            "Not found in sheet " & SheetName & ": " & Text.Combine(Missing, ", ")
				                & ". Headers found: " & Text.Combine(ExcelHeaders, ", ")),
				    KeptColumns = Table.SelectColumns(Renamed, Names),
				
				    // ---- 3. Drop empty rows ------------------------------------------------
				    NonEmptyRows = Table.SelectRows(
				        KeptColumns,
				        each [PO Number] <> null and Text.Trim(Text.From([PO Number])) <> ""),
				
				    // ---- 4. Cast every column (empty cells and "" become null) -------------
				    IsBlank   = (v as any) as logical => v = null or (v is text and Text.Trim(v) = ""),
				    ToText    = (v as any) as nullable text => if IsBlank(v) then null else Text.Clean(Text.Trim(Text.From(v))),
				    ToDecimal = (v as any) as nullable number =>
				        if IsBlank(v) then null
				        else if v is number then v
				        else let t = Text.Remove(Text.Trim(Text.From(v)), {" ", Character.FromNumber(160)})
				             in  try Number.FromText(t, "en-US") otherwise try Number.FromText(t, "fr-FR") otherwise null,
				    ToWhole   = (v as any) as nullable number => let n = ToDecimal(v) in if n = null then null else Int64.From(n),
				    ToDate    = (v as any) as nullable date =>
				        if IsBlank(v) then null
				        else if v is date then v
				        else if v is datetime or v is number then Date.From(v)
				        else let t = Text.Trim(Text.From(v))
				             in  try Date.FromText(t, [Format = "dd/MM/yyyy", Culture = "en-US"]) otherwise try Date.From(t, "en-GB") otherwise null,
				    Casts = [
				        Text    = {ToText,    type text},
				        Date    = {ToDate,    type date},
				        Whole   = {ToWhole,   Int64.Type},
				        Decimal = {ToDecimal, type number}
				    ],
				    Typed = Table.TransformColumns(
				        NonEmptyRows,
				        List.Transform(Columns, (c) => {c{0}} & Record.Field(Casts, c{1})))
				in
				    Typed

	annotation PBI_ResultType = Table
