table 'GR Log'
	lineageTag: 3866e78d-874e-4746-8668-581043206351

	measure 'GR Days Late' =
			VAR Planned  = SELECTEDVALUE ( 'GR Log'[Delivery Date] )
			VAR Received = COALESCE ( SELECTEDVALUE ( 'GR Log'[GR Date] ), TODAY () )  -- not received yet: use today
			RETURN
			    IF (
			        ISEMPTY ( 'GR Log' ) || ISBLANK ( Planned ),   -- filtered out, or no delivery date
			        BLANK (),
			        DATEDIFF ( Planned, Received, DAY )
			    )
		formatString: 0
		displayFolder: Goods Receipt
		lineageTag: 0e40887a-dfbd-488b-a51d-40af72cfbb12

	measure 'GR Indicator' =
			VAR Planned  = SELECTEDVALUE ( 'GR Log'[Delivery Date] )
			VAR Received = SELECTEDVALUE ( 'GR Log'[GR Date] )
			VAR Late     = [GR Days Late]
			RETURN
			    IF ( ISEMPTY ( 'GR Log' ), BLANK (),   -- line filtered out by a slicer: hide the row
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Planned ), UNICHAR ( 9898 ),                        -- white: no delivery date
			        ISBLANK ( Received ) && Planned >= TODAY (), UNICHAR ( 128309 ), -- blue: not received, not due yet
			        Late <= 1, UNICHAR ( 128994 ),                                -- green: early, on time or 1 day late
			        Late <= 3, UNICHAR ( 128992 ),                                -- orange: 2-3 days late
			        UNICHAR ( 128308 )                                            -- red: more than 3 days late
			    ))
		displayFolder: Goods Receipt
		lineageTag: c01f3534-c64e-4136-a6ab-0d5cfded656b

	measure 'Expiry Status' =
			-- Only batches whose expiry date falls in the current month; blank otherwise (hides the row).
			-- Expired / not yet expired comes from the Excel column Days to Expiry.
			VAR Expiry   = SELECTEDVALUE ( 'GR Log'[Expiry Date] )
			VAR DaysLeft = SELECTEDVALUE ( 'GR Log'[Days to Expiry] )
			VAR ThisMonth =
			    YEAR ( Expiry ) = YEAR ( TODAY () ) && MONTH ( Expiry ) = MONTH ( TODAY () )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Expiry ) || ISBLANK ( DaysLeft ) || NOT ThisMonth, BLANK (),
			        DaysLeft < 0, UNICHAR ( 128308 ) & "  Already expired",
			        UNICHAR ( 128992 ) & "  Will expire this month"
			    )
		displayFolder: Goods Receipt
		lineageTag: fcd23136-4a62-41f9-8232-4631f353ce8f

	measure 'GR POs' = DISTINCTCOUNT ( 'GR Log'[PO Number] )
		formatString: #,0
		displayFolder: Goods Receipt
		lineageTag: ef22821f-e1ed-4c3c-a127-fca348718859

	measure 'GR Clear Filters Active' =
			-- TRUE when any GR Log slicer has a selection
			ISFILTERED ( 'GR Log'[Supplier] )
			    || ISFILTERED ( 'GR Log'[Material] )
			    || ISFILTERED ( 'GR Log'[PO Number] )
			    || ISFILTERED ( 'GR Log'[Delivery Status] )
			    || ISFILTERED ( 'GR Log'[QC Status] )
		displayFolder: UI
		lineageTag: 3a111011-38e4-401e-81ac-f570088c6e4c

	measure 'GR Clear Button Fill' = IF ( [GR Clear Filters Active], "#C2434D", "#FFFFFF" )
		displayFolder: UI
		lineageTag: 687a4523-4948-45b5-ab90-9bd93aaacd8c

	measure 'GR Clear Button Text' = IF ( [GR Clear Filters Active], "#FFFFFF", "#2B01BE" )
		displayFolder: UI
		lineageTag: 5b0090f1-84b4-44a4-9e92-ba7e23b3f89b

