	partition 'PO Data' = m
		mode: import
		source =
				// ============================================================================
				// Power Query (M) – table "PO Data"
				// Source: the Excel file in the FilePath parameter (PO_Tracking_Dummy.xlsx).
				// Reads the sheet named in SheetName (case and extra spaces ignored).
				// Column names = the headers of that sheet.
				// ============================================================================
				let
				    SheetName = "Supply Tracking",
				
				    // ---- 1. Load -----------------------------------------------------------
				    Source   = Excel.Workbook(File.Contents(FilePath), true, true),   // true = first row is the header
				    Sheets   = Table.SelectRows(Source, each [Kind] = "Sheet"),
				    Matching = Table.SelectRows(Sheets, each Text.Lower(Text.Trim([Name])) = Text.Lower(SheetName)),
				    Raw      =
				        if not Table.IsEmpty(Matching) then Matching{0}[Data]
				        else error Error.Record(
				            "Sheet not found",
				            "No sheet named '" & SheetName & "' in " & FilePath
				                & ". Sheets found: " & Text.Combine(Sheets[Name], ", ")),
				
				    // Header cleanup: trim, drop line breaks, collapse double spaces
				    CleanHeaders = Table.TransformColumnNames(
				        Raw,
				        each Text.Combine(List.Select(Text.SplitAny(Text.Clean(Text.From(_)), " #(00A0)"), (w) => w <> ""), " ")),
				
				    // ---- 2. Expected columns (headers of PO_Tracking_Dummy.xlsx) -----------
				    // Matched case-insensitively, so "Order date" or "ORDER DATE" also work.
				    Columns = {
				        "PO Number", "Supplier", "Material", "Material Description", "PO Value", "Currency",
				        "Ordered Qty", "UoM", "Order Date", "Expedition Date from Supplier", "Planned Arrival Date",
				        "Actual arrival date Transit", "Reception Date", "Status"
				    },
				    ExcelHeaders = Table.ColumnNames(CleanHeaders),
				    FindHeader = (name as text) as nullable text =>
				        List.First(List.Select(ExcelHeaders, (h) => Text.Lower(h) = Text.Lower(name)), null),
				    Matches  = List.Transform(Columns, (c) => {FindHeader(c), c}),
				    Missing  = List.Transform(List.Select(Matches, each _{0} = null), each _{1}),
				    Renames  = List.Select(Matches, each _{0} <> null and _{0} <> _{1}),
				    Renamed  =
				        if List.IsEmpty(Missing) then Table.RenameColumns(CleanHeaders, Renames)
				        else error Error.Record(
				            "Missing columns",
				            "Not found in the Excel file: " & Text.Combine(Missing, ", ")
				                & ". Headers found: " & Text.Combine(ExcelHeaders, ", ")),
				    KeptColumns = Table.SelectColumns(Renamed, Columns),
				
				    // ---- 3. Drop empty rows ------------------------------------------------
				    NonEmptyRows = Table.SelectRows(
				        KeptColumns,
				        each [PO Number] <> null and Text.Trim(Text.From([PO Number])) <> ""),
				
				    // ---- 4. Helper functions -----------------------------------------------
				    // PO_Tracking_Dummy.xlsx stores real Excel dates, so no day/month swap.
				    // Set to true only for files where dd/mm dates were read as mm/dd.
				    // Text cells such as "20/01/2026" are parsed as dd/MM/yyyy.
				    SwapDayMonthOnExcelDates = false,
				
				    ToDate = (v as any) as nullable date =>
				        let
				            Swap = (d as date) as date =>
				                if SwapDayMonthOnExcelDates and Date.Day(d) <= 12
				                then #date(Date.Year(d), Date.Day(d), Date.Month(d))
				                else d,
				            Result =
				                if v = null then null
				                else if v is date then Swap(v)
				                else if v is datetime then Swap(Date.From(v))
				                else if v is number then Swap(Date.From(v))
				                else
				                    let
				                        t       = Text.Trim(Text.From(v)),
				                        Formats = {"dd/MM/yyyy", "d/M/yyyy", "dd-MM-yyyy", "dd.MM.yyyy", "yyyy-MM-dd", "dd/MM/yy"},
				                        Parsed  = List.First(
				                                    List.RemoveNulls(
				                                        List.Transform(Formats, (f) =>
				                                            try Date.FromText(t, [Format = f, Culture = "en-US"]) otherwise null)),
				                                    null)
				                    in
				                        if t = "" then null else Parsed
				        in
				            Result,
				
				    ToDecimal = (v as any) as nullable number =>
				        if v = null then null
				        else if v is number then v
				        else
				            let t = Text.Remove(Text.Trim(Text.From(v)), {" ", "€", "$", Character.FromNumber(160)})
				            in  if t = "" then null
				                else try Number.FromText(t, "en-US") otherwise try Number.FromText(t, "fr-FR") otherwise null,
				
				    CleanText = (v as any) as nullable text =>
				        if v = null then null
				        else let t = Text.Clean(Text.Trim(Text.From(v))) in if t = "" then null else t,
				
				    // ---- 5. Cast every column ----------------------------------------------
				    TypedText = Table.TransformColumns(
				        NonEmptyRows,
				        {{"PO Number",            CleanText, type text},
				         {"Supplier",             CleanText, type text},
				         {"Material",             CleanText, type text},
				         {"Material Description", CleanText, type text},
				         {"Currency",             each Text.Upper(CleanText(_)), type text},
				         {"UoM",                  each Text.Upper(CleanText(_)), type text},
				         {"Status",               CleanText, type text}}),
				
				    TypedNumbers = Table.TransformColumns(
				        TypedText,
				        {{"PO Value",    ToDecimal, type number},                       // Decimal Number
				         {"Ordered Qty", each let n = ToDecimal(_) in if n = null then null else Int64.From(n), Int64.Type}}),
				
				    TypedDates = Table.TransformColumns(
				        TypedNumbers,
				        {{"Order Date",                    ToDate, type date},
				         {"Expedition Date from Supplier", ToDate, type date},
				         {"Planned Arrival Date",          ToDate, type date},
				         {"Actual arrival date Transit",   ToDate, type date},
				         {"Reception Date",                ToDate, type date}}),
				
				    // ---- 6. Cycle time per PO (null when either date is missing) -----------
				    AddedCycleTime = Table.AddColumn(
				        TypedDates, "Cycle Time (Days)",
				        each if [Order Date] = null or [Reception Date] = null then null
				             else Duration.Days([Reception Date] - [Order Date]),
				        Int64.Type)
				in
				    AddedCycleTime

	annotation PBI_ResultType = Table

