table 'PO Data'
	lineageTag: fdcf3f9b-b4ba-4a5f-9935-7ba4d3a30449

	measure 'Total PO Numbers' = DISTINCTCOUNT ( 'PO Data'[PO Number] )
		formatString: #,0
		displayFolder: KPIs
		lineageTag: a6e7a704-8492-46ab-90fa-f63cf4f3996b

	measure 'Procurement Cycle Time (Days)' =
			AVERAGEX (
			    FILTER (
			        'PO Data',
			        NOT ISBLANK ( 'PO Data'[Order Date] )
			            && NOT ISBLANK ( 'PO Data'[Reception Date] )
			    ),
			    DATEDIFF ( 'PO Data'[Order Date], 'PO Data'[Reception Date], DAY )
			)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 36976643-2e8d-462f-b72b-33fb03edbd22

	measure 'Total PO Value' = SUM ( 'PO Data'[PO Value] )
		formatString: #,0.00
		displayFolder: KPIs
		lineageTag: f4172210-c451-4998-b604-4196eb7b7f2a

	measure 'Total Ordered Qty' = SUM ( 'PO Data'[Ordered Qty] )
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 8a170765-1ec7-41a2-81a6-1a6a853fa318

	measure 'Top Supplier' =
			VAR Ranked =
			    TOPN (
			        1,
			        ADDCOLUMNS ( VALUES ( 'PO Data'[Supplier] ), "@Value", [Total PO Value] ),
			        [@Value], DESC
			    )
			RETURN
			    CONCATENATEX ( Ranked, 'PO Data'[Supplier], ", " )
		displayFolder: Rankings
		lineageTag: 588ba694-734c-405c-86b5-4034fbf31eed

	measure 'Top 5 Materials Qty' =
			VAR Qty = [Total Ordered Qty]
			VAR RankNo =
			    RANKX ( ALLSELECTED ( 'PO Data'[Material] ), [Total Ordered Qty], , DESC, DENSE )
			RETURN
			    IF ( NOT ISBLANK ( Qty ) && RankNo <= 5, Qty )
		formatString: #,0
		displayFolder: Rankings
		lineageTag: 7077c7cd-28b4-4fa8-91d6-27c43a60e10b

	measure 'Arrival Days Late' =
			VAR Planned = SELECTEDVALUE ( 'PO Data'[Planned Arrival Date] )
			VAR Actual  = COALESCE ( SELECTEDVALUE ( 'PO Data'[Actual arrival date Transit] ), TODAY () )  -- not arrived yet: use today
			RETURN
			    IF (
			        ISEMPTY ( 'PO Data' ) || ISBLANK ( Planned ),   -- filtered out, or no planned date
			        BLANK (),
			        DATEDIFF ( Planned, Actual, DAY )
			    )
		formatString: 0
		displayFolder: Delivery
		lineageTag: d2aa73b0-b193-4192-82c1-f8e2c9a18624

	measure 'On-Time Delivery %' =
			VAR PerPO =
			    ADDCOLUMNS (
			        VALUES ( 'PO Data'[PO Number] ),
			        "@Late", [Arrival Days Late],
			        "@Arrived", NOT ISBLANK ( CALCULATE ( MAX ( 'PO Data'[Actual arrival date Transit] ) ) )
			    )
			-- POs that are due: already arrived, or not arrived and past the planned date
			VAR Evaluated = FILTER ( PerPO, NOT ISBLANK ( [@Late] ) && ( [@Arrived] || [@Late] > 0 ) )
			VAR OnTime    = FILTER ( Evaluated, [@Arrived] && [@Late] <= 0 )
			RETURN
			    DIVIDE ( COUNTROWS ( OnTime ) + 0, COUNTROWS ( Evaluated ) )   -- +0 so a supplier with no on-time POs shows 0%, not blank
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: fba653a0-e459-44eb-81c4-380f3b61f122

	measure 'Arrival Indicator' =
			VAR Planned = SELECTEDVALUE ( 'PO Data'[Planned Arrival Date] )
			VAR Actual  = SELECTEDVALUE ( 'PO Data'[Actual arrival date Transit] )
			VAR Late    = [Arrival Days Late]
			RETURN
			    IF ( ISEMPTY ( 'PO Data' ), BLANK (),   -- PO filtered out by a slicer: hide the row
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Planned ), UNICHAR ( 9898 ),                       -- white: no planned date
			        ISBLANK ( Actual ) && Planned >= TODAY (), UNICHAR ( 128309 ), -- blue: not due yet
			        Late <= 7, UNICHAR ( 128994 ),                               -- green: on time, early, or up to 7 days late
			        Late <= 21, UNICHAR ( 128992 ),                              -- orange: 8-21 days late
			        UNICHAR ( 128308 )                                           -- red: more than 21 days late
			    ))
		displayFolder: Delivery
		lineageTag: d71e4aeb-4b5b-4766-8b1a-71061e5bea97

	measure 'Arrival Status' =
			VAR Planned = SELECTEDVALUE ( 'PO Data'[Planned Arrival Date] )
			VAR Actual  = SELECTEDVALUE ( 'PO Data'[Actual arrival date Transit] )
			VAR Late    = [Arrival Days Late]
			RETURN
			    IF ( ISEMPTY ( 'PO Data' ), BLANK (),   -- PO filtered out by a slicer: hide the row
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Planned ), "No planned date",
			        ISBLANK ( Actual ) && Planned >= TODAY (),
			            "Upcoming - due in " & DATEDIFF ( TODAY (), Planned, DAY ) & " day(s): confirm ETA with supplier",
			        ISBLANK ( Actual ),
			            "Not arrived - " & Late & " day(s) overdue: expedite with supplier",
			        Late < 0, "Arrived early (" & -Late & " day(s))",
			        Late = 0, "On time",
			        "Arrived " & Late & " day(s) late"
			    ))
		displayFolder: Delivery
		lineageTag: 1fd48578-5472-4b2b-afcb-ca3bef91669d

	measure 'Clear Filters Active' =
			-- TRUE when any slicer (sidebar or page) has a selection
			ISFILTERED ( 'Order Calendar'[Year] )
			    || ISFILTERED ( 'Order Calendar'[Month Name] )
			    || ISFILTERED ( 'PO Data'[Supplier] )
			    || ISFILTERED ( 'PO Data'[Material] )
			    || ISFILTERED ( 'PO Data'[PO Number] )
			    || ISFILTERED ( 'PO Data'[Status] )
			    || ISFILTERED ( 'Planned Arrival Calendar'[Month] )
			    || ISFILTERED ( 'Actual Arrival Calendar'[Month] )
			    || ISFILTERED ( 'Reception Calendar'[Month] )
		displayFolder: UI
		lineageTag: 105d22d6-5fb5-40c8-b5c4-6460c6aaea99

	measure 'Clear Button Fill' = IF ( [Clear Filters Active], "#C2434D", "#FFFFFF" )
		displayFolder: UI
		lineageTag: dd2f2b4c-de63-4f44-bc1f-e1c9f07a9a69

	measure 'Clear Button Text' = IF ( [Clear Filters Active], "#FFFFFF", "#2B01BE" )
		displayFolder: UI
		lineageTag: 85a441cf-cfd8-4f80-a3bd-5b063645624e

	measure 'Avg Supplier Lead Time (Days)' =
			-- Expedition Date from Supplier - Order Date; rows with either date blank are skipped (for this average only)
			AVERAGEX (
			    FILTER (
			        'PO Data',
			        NOT ISBLANK ( 'PO Data'[Order Date] )
			            && NOT ISBLANK ( 'PO Data'[Expedition Date from Supplier] )
			    ),
			    DATEDIFF ( 'PO Data'[Order Date], 'PO Data'[Expedition Date from Supplier], DAY )
			)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: e72a6440-efe0-4046-b103-8c4bd2421be8

	measure 'Avg Transit Time (Days)' =
			-- Actual arrival date Transit - Expedition Date from Supplier; rows with either date blank are skipped (for this average only)
			AVERAGEX (
			    FILTER (
			        'PO Data',
			        NOT ISBLANK ( 'PO Data'[Expedition Date from Supplier] )
			            && NOT ISBLANK ( 'PO Data'[Actual arrival date Transit] )
			    ),
			    DATEDIFF ( 'PO Data'[Expedition Date from Supplier], 'PO Data'[Actual arrival date Transit], DAY )
			)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 8f1ac36c-de88-4cf2-bdd9-cc66d83af4ee

	measure 'Avg Local Customs Time (Days)' =
			-- Reception Date - Actual arrival date Transit; rows with either date blank are skipped (for this average only)
			AVERAGEX (
			    FILTER (
			        'PO Data',
			        NOT ISBLANK ( 'PO Data'[Actual arrival date Transit] )
			            && NOT ISBLANK ( 'PO Data'[Reception Date] )
			    ),
			    DATEDIFF ( 'PO Data'[Actual arrival date Transit], 'PO Data'[Reception Date], DAY )
			)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: f0dfa641-4c52-4eea-aa21-9a98344b27dc

